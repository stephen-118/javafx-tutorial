<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>

<fx:root type="HBox" alignment="TOP_RIGHT" spacing="10.0"
         stylesheets="@/css/dialog-box.css"
         xmlns="http://javafx.com/javafx/17.0.7"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog" maxWidth="Infinity" minHeight="-Infinity"
               styleClass="chat-label" wrapText="true">
            <HBox.hgrow>
                <Priority fx:constant="ALWAYS" />
            </HBox.hgrow>
        </Label>
        <ImageView fx:id="displayPicture" fitHeight="100.0" fitWidth="100.0"
                   preserveRatio="true" />
    </children>
</fx:root>
